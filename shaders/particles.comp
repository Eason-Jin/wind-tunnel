#version 460 core
// Advects a buffer of smoke/tracer particles through the flow field with
// RK2 (midpoint), handling respawn (age-out / left the grid / hit solid /
// stuck) and full reinitialisation (uReset), spread across their lifetimes
// so the first frame is not empty.
layout(local_size_x = 256) in;

struct Particle {
    vec4 posAge;   // xyz = world position, w = age (s)
    vec4 prevLife; // xyz = previous position (for streak rendering), w = lifetime (s)
};

layout(std430, binding = 0) buffer ParticleBuffer {
    Particle particles[];
};

uniform sampler3D uFlow;
uniform sampler3D uSolid;
uniform vec3 uGridMin;
uniform vec3 uGridSize;
uniform float uFreestream;

uniform float uDt;
uniform float uTimeScale;
uniform int uFrame;
uniform int uSeed;
uniform int uParticleCount;
uniform int uReset;       // 1 = fully reinitialise every particle this dispatch
uniform int uPaused;      // 1 = skip advection (state unchanged)
uniform int uEmitterMode; // 0 = inlet plane, 1 = whole (non-solid) domain

uniform float uLifetimeMin;
uniform float uLifetimeMax;
uniform float uInletX;
uniform vec2 uInletCenter;   // y, z
uniform vec2 uInletHalfSize; // y, z half-extent

// --- PCG-style hash / RNG ---------------------------------------------------

uint pcgHash(uint v)
{
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randFloat(inout uint state)
{
    state = pcgHash(state);
    return float(state) * (1.0 / 4294967296.0);
}

// --- Field sampling (compute has no implicit derivatives: textureLod only) -

vec3 sampleVelocity(vec3 worldPos)
{
    vec3 tc = (worldPos - uGridMin) / uGridSize;
    return textureLod(uFlow, tc, 0.0).rgb;
}

bool insideGrid(vec3 tc)
{
    return all(greaterThanEqual(tc, vec3(0.0))) && all(lessThanEqual(tc, vec3(1.0)));
}

bool isSolidAt(vec3 tc)
{
    return textureLod(uSolid, tc, 0.0).r > 0.5;
}

vec3 emitPosition(inout uint state)
{
    if (uEmitterMode == 0) {
        float ry = (randFloat(state) - 0.5) * 2.0 * uInletHalfSize.x;
        float rz = (randFloat(state) - 0.5) * 2.0 * uInletHalfSize.y;
        return vec3(uInletX, uInletCenter.x + ry, uInletCenter.y + rz);
    }

    for (int attempt = 0; attempt < 8; ++attempt) {
        vec3 t = vec3(randFloat(state), randFloat(state), randFloat(state));
        if (!isSolidAt(t))
            return uGridMin + t * uGridSize;
    }
    // Fallback: every random sample landed inside the body; use the inlet plane.
    float ry = (randFloat(state) - 0.5) * 2.0 * uInletHalfSize.x;
    float rz = (randFloat(state) - 0.5) * 2.0 * uInletHalfSize.y;
    return vec3(uInletX, uInletCenter.x + ry, uInletCenter.y + rz);
}

void main()
{
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= uint(uParticleCount))
        return;

    uint state = idx * 2654435761u + uint(uFrame) * 747796405u + uint(uSeed);
    state = pcgHash(state);

    if (uReset != 0) {
        // Full reinitialisation: stagger ages across [0, lifetime) and
        // pre-advect each particle by its age so the domain is already
        // populated on the very first frame instead of clustered at the
        // emitter.
        float lifetime = mix(uLifetimeMin, uLifetimeMax, randFloat(state));
        float age = randFloat(state) * lifetime;
        vec3 pos = emitPosition(state);
        vec3 prevPos = pos;

        const int kSubSteps = 8;
        float dtSub = age / float(kSubSteps);
        for (int s = 0; s < kSubSteps; ++s) {
            vec3 v1 = sampleVelocity(pos);
            vec3 mid = pos + 0.5 * dtSub * uTimeScale * v1;
            vec3 v2 = sampleVelocity(mid);
            prevPos = pos;
            pos = pos + dtSub * uTimeScale * v2;
        }

        particles[idx].posAge = vec4(pos, age);
        particles[idx].prevLife = vec4(prevPos, lifetime);
        return;
    }

    Particle p = particles[idx];
    vec3 pos = p.posAge.xyz;
    float age = p.posAge.w;
    float lifetime = p.prevLife.w;
    bool respawn = false;

    if (uPaused == 0) {
        vec3 v1 = sampleVelocity(pos);
        float stepDt = uDt * uTimeScale;
        vec3 mid = pos + 0.5 * stepDt * v1;
        vec3 v2 = sampleVelocity(mid);
        vec3 newPos = pos + stepDt * v2;
        age += uDt;

        vec3 tcNew = (newPos - uGridMin) / uGridSize;
        bool inGrid = insideGrid(tcNew);
        bool solid = inGrid && isSolidAt(tcNew);
        float speed = length(v2);

        if (age >= lifetime || !inGrid || solid || speed < 0.01 * uFreestream) {
            respawn = true;
        } else {
            p.prevLife.xyz = pos;
            p.posAge = vec4(newPos, age);
        }
    }

    if (respawn) {
        float newLifetime = mix(uLifetimeMin, uLifetimeMax, randFloat(state));
        vec3 newPos = emitPosition(state);
        p.posAge = vec4(newPos, 0.0);
        p.prevLife = vec4(newPos, newLifetime);
    }

    particles[idx] = p;
}
